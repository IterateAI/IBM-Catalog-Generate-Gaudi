POSTGRES_USER=broker
POSTGRES_PASSWORD=brokerpass
POSTGRES_DB=brokerdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=secret

REDIS_URL=redis://redis:6379/0

# IBM Cloud Configuration
IBMCLOUD_API_KEY=your_ibm_cloud_api_key_here
IBMCLOUD_REGION=us-south

# Terraform Configuration
TERRAFORM_DIR=/terraform

# Docker Registry Configuration
DOCKER_USER=your_docker_username
DOCKER_PASS=your_docker_password

# Usage Service Configuration (IBM Metering)
RESOURCE_ID=your_ibm_resource_id # u can find this value as the Global catalog ID listed on the Brokers tab in Partner Center.
IBM_TOKEN=your_ibm_token_for_testing
USAGE_API_KEY=USAGE_API_KEY
