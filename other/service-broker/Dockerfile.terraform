# Celery worker container with Terraform capabilities
FROM hashicorp/terraform:1.14.1

# Install additional tools and Python
RUN apk add --no-cache \
    bash \
    curl \
    jq \
    python3 \
    py3-pip \
    python3-dev \
    gcc \
    musl-dev \
    postgresql-dev

# Install IBM Cloud CLI and plugins
RUN curl -fsSL https://clis.cloud.ibm.com/install/linux | sh && \
    ibmcloud plugin install infrastructure-service && \
    ibmcloud plugin install container-service

# Create terraform working directory
RUN mkdir -p /terraform/workspace

# Set working directory for the app
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt /app/
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Copy application code
COPY app/auth.py /app/app/auth.py
COPY app/celery.py /app/app/celery.py
COPY app/tasks.py /app/app/tasks.py
COPY app/main.py /app/app/main.py
COPY app/database.py /app/app/database.py
COPY app/models.py /app/app/models.py
COPY app/schemas.py /app/app/schemas.py
COPY app/__init__.py /app/app/__init__.py

COPY terraform/ /terraform/base/

# Create dummy SSH private key for internal use
# RUN mkdir -p /app/keys && \
#     printf "-----BEGIN PRIVATE KEY-----\nDUMMY-KEY-CONTENT-NOT-FOR-USE\n-----END PRIVATE KEY-----\n" > /app/keys/id_rsa && \
#     chmod 600 /app/keys/dummy_id_rsa

# Set environment variables (runtime values will override these defaults)
ENV PYTHONPATH=/app
ENV TF_LOG="INFO"
ENV TF_LOG_PATH="/terraform/terraform.log"

# Create entrypoint script that initializes IBM Cloud and runs the command
RUN printf '#!/bin/bash\nset -e\n\n# Initialize IBM Cloud CLI if API key is provided\nif [ ! -z "$IBMCLOUD_API_KEY" ]; then\n    echo "Logging into IBM Cloud..."\n    ibmcloud login --apikey "$IBMCLOUD_API_KEY" -r "$IBMCLOUD_REGION" --quiet || echo "IBM Cloud login failed, continuing..."\nfi\n\n# Execute the command passed to the container\nexec "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["celery", "-A", "app.celery", "worker", "--loglevel=info", "--concurrency=1"]
